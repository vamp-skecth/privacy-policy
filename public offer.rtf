\par \pard\plain \s147\loch\sl276\slmult1\sb0\sa140\sl276\slmult1{\loch
\u1040\'c0\u1082\'ea\u1094\'f6\u1077\'e5\u1087\'ef\u1090\'f2 \u8211\'96 \u1087\'ef\u1086\'ee\u1083\'eb\u1085\'ed\u1086\'ee\u1077\'e5 \u1080\'e8 \u1073\'e1\u1077\'e5\u1079\'e7\u1086\'ee\u1075\'e3\u1086\'ee\u1074\'e2\u1086\'ee\u1088\'f0\u1086\'ee\u1095\'f7\u1085\'ed\u1086\'ee\u1077\'e5 \u1087\'ef\u1088\'f0\u1080\'e8\u1085\'ed\u1103\'ff\u1090\'f2\u1080\'e8\u1077\'e5 \u1051\'cb\u1080\'e8\u1094\'f6\u1077\'e5\u1085\'ed\u1079\'e7\u1080\'e8\u1072\'e0\u1090\'f2\u1086\'ee\u1084\'ec \u1091\'f3\u1089\'f1\u1083\'eb\u1086\'ee\u1074\'e2\u1080\'e8\u1081\'e9 \u1085\'ed\u1072\'e0\u1089\'f1\u1090\'f2\u1086\'ee\u1103\'ff\u1097\'f9\u1077\'e5\u1081\'e9 \u1086\'ee\u1092\'f4\u1077\'e5\u1088\'f0\u1090\'f2\u1099\'fb, \u1074\'e2\u1099\'fb\u1088\'f0\u1072\'e0\u1078\'e6\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1077\'e5 \u1087\'ef\u1091\'f3\u1090\'f2\u1077\'e5\u1084\'ec \u1086\'ee\u1087\'ef\u1083\'eb\u1072\'e0\u1090\'f2\u1099\'fb \u1055\'cf\u1088\'f0\u1086\'ee\u1076\'e4\u1091\'f3\u1082\'ea\u1090\'f2\u1072\'e0. \u1052\'cc\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1072\'e0\u1082\'ea\u1094\'f6\u1077\'e5\u1087\'ef\u1090\'f2\u1072\'e0 = \u1084\'ec\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1090\'f2 \u1079\'e7\u1072\'e0\u1095\'f7\u1080\'e8\u1089\'f1\u1083\'eb\u1077\'e5\u1085\'ed\u1080\'e8\u1103\'ff \u1076\'e4\u1077\'e5\u1085\'ed\u1077\'e5\u1078\'e6\u1085\'ed\u1099\'fb\u1093\'f5 \u1089\'f1\u1088\'f0\u1077\'e5\u1076\'e4\u1089\'f1\u1090\'f2\u1074\'e2 \u1085\'ed\u1072\'e0 \u1089\'f1\u1095\'f7\u1077\'e5\u1090\'f2 \u1051\'cb\u1080\'e8\u1094\'f6\u1077\'e5\u1085\'ed\u1079\'e7\u1080\'e8\u1072\'e0\u1088\'f0\u1072\'e0 \u1080\'e8\u1083\'eb\u1080\'e8 \u1087\'ef\u1083\'eb\u1072\'e0\u1090\'f2\u1077\'e5\u1078\'e6\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1072\'e0\u1075\'e3\u1077\'e5\u1085\'ed\u1090\'f2\u1072\'e0.}
\par \pard\plain \s147\loch\sl276\slmult1\sb0\sa140\sl276\slmult1{\loch
\u1055\'cf\u1088\'f0\u1086\'ee\u1076\'e4\u1091\'f3\u1082\'ea\u1090\'f2 (\u1062\'d6\u1080\'e8\u1092\'f4\u1088\'f0\u1086\'ee\u1074\'e2\u1086\'ee\u1081\'e9 \u1080\'e8\u1085\'ed\u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0\u1094\'f6\u1080\'e8\u1086\'ee\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1087\'ef\u1088\'f0\u1086\'ee\u1076\'e4\u1091\'f3\u1082\'ea\u1090\'f2) \u8211\'96 \u1087\'ef\u1072\'e0\u1082\'ea\u1077\'e5\u1090\'f2 \u171\'ab\u1062\'d6\u1080\'e8\u1092\'f4\u1088\'f0\u1086\'ee\u1074\'e2\u1086\'ee\u1081\'e9 \u1090\'f2\u1072\'e0\u1082\'ea\u1090\'f2\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8\u1081\'e9 \u1075\'e3\u1072\'e0\u1081\'e9\u1076\'e4 \u1087\'ef\u1086\'ee \u1082\'ea\u1086\'ee\u1084\'ec\u1080\'e8\u1089\'f1\u1089\'f1\u1072\'e0\u1094\'f6\u1080\'e8\u1080\'e8 \u1076\'e4\u1083\'eb\u1103\'ff \u1089\'f1\u1088\'f0\u1086\'ee\u1095\'f7\u1085\'ed\u1080\'e8\u1082\'ea\u1086\'ee\u1074\'e2\u187\'bb, \u1074\'e2\u1082\'ea\u1083\'eb\u1102\'fe\u1095\'f7\u1072\'e0\u1102\'fe\u1097\'f9\u1080\'e8\u1081\'e9:}
\par \pard\plain \s147\loch\sl276\slmult1\sb0\sa140\sl276\slmult1{\loch
- \u1040\'c0\u1074\'e2\u1090\'f2\u1086\'ee\u1088\'f0\u1089\'f1\u1082\'ea\u1080\'e8\u1081\'e9 \u1094\'f6\u1080\'e8\u1092\'f4\u1088\'f0\u1086\'ee\u1074\'e2\u1086\'ee\u1081\'e9 \u1075\'e3\u1072\'e0\u1081\'e9\u1076\'e4 \u1074\'e2 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0\u1090\'f2\u1077\'e5 PDF (12 \u1089\'f1\u1090\'f2\u1088\'f0\u1072\'e0\u1085\'ed\u1080\'e8\u1094\'f6), \u1089\'f1\u1090\'f2\u1088\'f0\u1091\'f3\u1082\'ea\u1090\'f2\u1091\'f3\u1088\'f0\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1081\'e9 \u1087\'ef\u1086\'ee \u1101\'fd\u1090\'f2\u1072\'e0\u1087\'ef\u1072\'e0\u1084\'ec \u1076\'e4\u1083\'eb\u1103\'ff \u1084\'ec\u1086\'ee\u1076\'e4\u1077\'e5\u1083\'eb\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1103\'ff \u1080\'e8\u1085\'ed\u1076\'e4\u1080\'e8\u1074\'e2\u1080\'e8\u1076\'e4\u1091\'f3\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1093\'f5 \u1102\'fe\u1088\'f0\u1080\'e8\u1076\'e4\u1080\'e8\u1095\'f7\u1077\'e5\u1089\'f1\u1082\'ea\u1080\'e8\u1093\'f5 \u1089\'f1\u1090\'f2\u1088\'f0\u1072\'e0\u1090\'f2\u1077\'e5\u1075\'e3\u1080\'e8\u1081\'e9 \u1076\'e4\u1086\'ee\u1089\'f1\u1091\'f3\u1076\'e4\u1077\'e5\u1073\'e1\u1085\'ed\u1086\'ee\u1075\'e3\u1086\'ee \u1091\'f3\u1088\'f0\u1077\'e5\u1075\'e3\u1091\'f3\u1083\'eb\u1080\'e8\u1088\'f0\u1086\'ee\u1074\'e2\u1072\'e0\u1085\'ed\u1080\'e8\u1103\'ff \u1074\'e2\u1086\'ee\u1087\'ef\u1088\'f0\u1086\'ee\u1089\'f1\u1086\'ee\u1074\'e2 \u1082\'ea\u1086\'ee\u1084\'ec\u1080\'e8\u1089\'f1\u1089\'f1\u1072\'e0\u1094\'f6\u1080\'e8\u1080\'e8 \u1074\'e2\u1086\'ee\u1077\'e5\u1085\'ed\u1085\'ed\u1086\'ee\u1089\'f1\u1083\'eb\u1091\'f3\u1078\'e6\u1072\'e0\u1097\'f9\u1080\'e8\u1093\'f5 \u1089\'f1\u1088\'f0\u1086\'ee\u1095\'f7\u1085\'ed\u1086\'ee\u1081\'e9 \u1089\'f1\u1083\'eb\u1091\'f3\u1078\'e6\u1073\'e1\u1099\'fb;}

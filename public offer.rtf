- \u1043\'c3\u1088\'f0\u1072\'e0\u1078\'e6\u1076\'e4\u1072\'e0\u1085\'ed\u1089\'f1\u1082\'ea\u1080\'e8\u1084\'ec \u1082\'ea\u1086\'ee\u1076\'e4\u1077\'e5\u1082\'ea\u1089\'f1\u1086\'ee\u1084\'ec \u1056\'d0\u1060\'d4 (\u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1100\'fc \u1087\'ef\u1077\'e5\u1088\'f0\u1074\'e2\u1072\'e0\u1103\'ff \u1086\'ee\u1090\'f2 30.11.1994 \u8470\'b9 51-\u1060\'d4\u1047\'c7, \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1100\'fc \u1074\'e2\u1090\'f2\u1086\'ee\u1088\'f0\u1072\'e0\u1103\'ff \u1086\'ee\u1090\'f2 26.01.1996 \u8470\'b9 14-\u1060\'d4\u1047\'c7, \u1095\'f7\u1072\'e0\u1089\'f1\u1090\'f2\u1100\'fc \u1095\'f7\u1077\'e5\u1090\'f2\u1074\'e2\u1077\'e5\u1088\'f0\u1090\'f2\u1072\'e0\u1103\'ff \u1086\'ee\u1090\'f2 18.12.2006 \u8470\'b9 230-\u1060\'d4\u1047\'c7)\line - \u1047\'c7\u1072\'e0\u1082\'ea\u1086\'ee\u1085\'ed\u1086\'ee\u1084\'ec \u1056\'d0\u1060\'d4 \u1086\'ee\u1090\'f2 07.02.1992 \u8470\'b9 2300-1 \u171\'ab\u1054\'ce \u1079\'e7\u1072\'e0\u1097\'f9\u1080\'e8\u1090\'f2\u1077\'e5 \u1087\'ef\u1088\'f0\u1072\'e0\u1074\'e2 \u1087\'ef\u1086\'ee\u1090\'f2\u1088\'f0\u1077\'e5\u1073\'e1\u1080\'e8\u1090\'f2\u1077\'e5\u1083\'eb\u1077\'e5\u1081\'e9\u187\'bb\line - \u1060\'d4\u1077\'e5\u1076\'e4\u1077\'e5\u1088\'f0\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1084\'ec \u1079\'e7\u1072\'e0\u1082\'ea\u1086\'ee\u1085\'ed\u1086\'ee\u1084\'ec \u1086\'ee\u1090\'f2 27.07.2006 \u8470\'b9 152-\u1060\'d4\u1047\'c7 \u171\'ab\u1054\'ce \u1087\'ef\u1077\'e5\u1088\'f0\u1089\'f1\u1086\'ee\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1099\'fb\u1093\'f5 \u1076\'e4\u1072\'e0\u1085\'ed\u1085\'ed\u1099\'fb\u1093\'f5\u187\'bb}
\par \pard\plain \s147\loch\sl276\slmult1\sb0\sa140\sl276\slmult1\qc{\loch
